//@version=6
// ============================================================================
//  Multi-School Stock Analyzer  —  مُحلِّل الأسهم متعدد المدارس
//  مؤشر احترافي شامل لمنصة TradingView يجمع مدارس التحليل الفني:
//    1) الاتجاه (Trend)            - شريط المتوسطات + اتجاه عام
//    2) الزخم (Momentum)           - RSI / MACD / Stochastic
//    3) التقلب (Volatility)        - Bollinger Bands + ATR
//    4) الدعم والمقاومة (S/R)      - Pivot High/Low تلقائي
//    5) فيبوناتشي (Fibonacci)      - ارتداد آلي من آخر سوينج
//    6) إيشيموكو (Ichimoku Cloud)
//    7) الحجم (Volume)             - انفجارات الحجم + OBV
//    8) نماذج الشموع (Candles)     - ابتلاع / مطرقة / دوجي ...
//    9) أموال المؤسسات (SMC)       - هيكل السوق / كسر الهيكل BOS
//   10) لوحة قرار مجمّعة (Dashboard) بنتيجة مرجّحة Buy/Sell
//
//  ملاحظة: مؤشر مساعد للقرار وليس توصية مالية. اختبره قبل الاستخدام الحقيقي.
// ============================================================================

indicator("Multi-School Stock Analyzer • محلل المدارس", shorttitle="MSA • محلل", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ============================================================================
//  إعدادات عامة
// ============================================================================
GRP_GEN  = "⚙️ عام"
showDash    = input.bool(true,  "إظهار لوحة المعلومات",      group=GRP_GEN)
dashPos     = input.string("أعلى اليمين", "موضع اللوحة", options=["أعلى اليمين","أعلى اليسار","أسفل اليمين","أسفل اليسار"], group=GRP_GEN)
themeDark   = input.bool(true,  "ثيم داكن",                   group=GRP_GEN)
displayMode = input.string("نظيف", "وضع العرض على الشارت", options=["نظيف","متوسط","كامل"], group=GRP_GEN, tooltip="نظيف = إشارات كول/بوت فقط • متوسط = + الأحداث الرئيسية • كامل = كل شيء")
eventsBack  = input.int(50, "إظهار الأحداث في آخر (عدد شموع)", minval=10, group=GRP_GEN)

// ألوان الثيم
cUp    = color.new(#26a69a, 0)
cDn    = color.new(#ef5350, 0)
cNeu   = color.new(#787b86, 0)
cTxt   = themeDark ? color.white : color.black
cBgDash= themeDark ? color.new(#1e222d, 10) : color.new(#ffffff, 10)

// بوابات التنظيف: تتحكم في كثافة الرسومات لتفادي ازدحام الشارت
_clean    = displayMode == "نظيف"
_full     = displayMode == "كامل"
recentBar = bar_index >= last_bar_index - eventsBack
gMinor    = _full and recentBar          // أحداث ثانوية (شموع فردية/حجم/تشبع)
gMajor    = (not _clean) and recentBar   // أحداث رئيسية (BOS/دايفرجنس/وايكوف/تصحيح)
gStruct   = not _clean                   // رسومات بنيوية على آخر شمعة (موجات/هارمونك/تنبؤ)

// ============================================================================
//  1) الاتجاه  —  Trend (EMA Ribbon)
// ============================================================================
GRP_TR = "📈 1) الاتجاه"
showTrend = input.bool(true,  "تفعيل مدرسة الاتجاه", group=GRP_TR)
emaFast   = input.int(20,  "EMA سريع",  minval=1, group=GRP_TR)
emaMid    = input.int(50,  "EMA متوسط", minval=1, group=GRP_TR)
emaSlow   = input.int(200, "EMA بطيء",  minval=1, group=GRP_TR)

ema1 = ta.ema(close, emaFast)
ema2 = ta.ema(close, emaMid)
ema3 = ta.ema(close, emaSlow)

trendUp   = close > ema1 and ema1 > ema2 and ema2 > ema3
trendDn   = close < ema1 and ema1 < ema2 and ema2 < ema3
// نقاط الاتجاه: +1 صاعد، -1 هابط، 0 عرضي
trendScore = trendUp ? 1 : trendDn ? -1 : (close > ema3 ? 1 : close < ema3 ? -1 : 0)

plot(showTrend ? ema1 : na, "EMA سريع",  color=color.new(#42a5f5, 0), linewidth=1)
plot(showTrend ? ema2 : na, "EMA متوسط", color=color.new(#ffa726, 0), linewidth=2)
plot(showTrend ? ema3 : na, "EMA بطيء",  color=color.new(#ab47bc, 0), linewidth=3)

// تعبئة بين السريع والمتوسط لإظهار قوة الاتجاه
p1 = plot(showTrend ? ema1 : na, display=display.none)
p2 = plot(showTrend ? ema2 : na, display=display.none)
fill(p1, p2, color=ema1 > ema2 ? color.new(#26a69a, 85) : color.new(#ef5350, 85))

// ============================================================================
//  2) الزخم  —  Momentum (RSI + MACD + Stochastic)
// ============================================================================
GRP_MO = "⚡ 2) الزخم"
showMom   = input.bool(true, "تفعيل مدرسة الزخم", group=GRP_MO)
rsiLen    = input.int(14, "RSI طول",    minval=1, group=GRP_MO)
rsiOB     = input.int(70, "RSI تشبع شرائي", group=GRP_MO)
rsiOS     = input.int(30, "RSI تشبع بيعي", group=GRP_MO)

rsi  = ta.rsi(close, rsiLen)
[macdLine, signalLine, _hist] = ta.macd(close, 12, 26, 9)
k = ta.stoch(close, high, low, 14)
stochK = ta.sma(k, 3)

momRsi   = rsi > 55 ? 1 : rsi < 45 ? -1 : 0
momMacd  = macdLine > signalLine ? 1 : -1
momStoch = stochK > 50 ? 1 : -1
momScore = momRsi + momMacd + momStoch        // المدى -3..+3
momNorm  = momScore > 0 ? 1 : momScore < 0 ? -1 : 0

// إشارات تشبع على الشارت (نحسب التقاطعات في متغيرات عامة لضمان تنفيذها كل شمعة)
rsiCrossDn = ta.crossunder(rsi, rsiOB)
rsiCrossUp = ta.crossover(rsi, rsiOS)
plotshape(showMom and gMinor and rsiCrossDn ? high : na, "تشبع شرائي", shape.triangledown, location.abovebar, color.new(#ef5350,0), size=size.tiny)
plotshape(showMom and gMinor and rsiCrossUp ? low : na,  "تشبع بيعي",  shape.triangleup,   location.belowbar, color.new(#26a69a,0), size=size.tiny)

// ============================================================================
//  3) التقلب  —  Volatility (Bollinger Bands + ATR)
// ============================================================================
GRP_VO = "🌊 3) التقلب"
showBB  = input.bool(true, "تفعيل بولينجر باند", group=GRP_VO)
bbLen   = input.int(20, "BB طول", minval=1, group=GRP_VO)
bbMult  = input.float(2.0, "BB انحراف", step=0.1, group=GRP_VO)

bbBasis = ta.sma(close, bbLen)
bbDev   = bbMult * ta.stdev(close, bbLen)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev

bu = plot(showBB ? bbUpper : na, "BB علوي", color=color.new(#787b86, 40))
bl = plot(showBB ? bbLower : na, "BB سفلي", color=color.new(#787b86, 40))
plot(showBB ? bbBasis : na, "BB وسط", color=color.new(#787b86, 60))
fill(bu, bl, color=color.new(#787b86, 92))

// نقاط التقلب: قرب الباند السفلي = فرصة شراء، العلوي = حذر
volScore = close <= bbLower ? 1 : close >= bbUpper ? -1 : 0

// ============================================================================
//  4) الدعم والمقاومة  —  Support / Resistance (Pivots)
// ============================================================================
GRP_SR = "🧱 4) الدعم والمقاومة"
showSR  = input.bool(true, "تفعيل الدعم/المقاومة", group=GRP_SR)
srLen   = input.int(15, "حساسية البيفوت", minval=2, group=GRP_SR)
srMax   = input.int(4,  "عدد الخطوط لكل جهة", minval=1, maxval=10, group=GRP_SR)

ph = ta.pivothigh(high, srLen, srLen)
pl = ta.pivotlow(low,  srLen, srLen)

var array<line>  resLines = array.new<line>()
var array<line>  supLines = array.new<line>()

f_pushLine(arr, price, col) =>
    ln = line.new(bar_index - srLen, price, bar_index, price, color=col, width=1, extend=extend.right, style=line.style_dashed)
    array.push(arr, ln)
    if array.size(arr) > srMax
        line.delete(array.shift(arr))

if showSR and not na(ph)
    f_pushLine(resLines, ph, color.new(#ef5350, 20))
if showSR and not na(pl)
    f_pushLine(supLines, pl, color.new(#26a69a, 20))

// ============================================================================
//  5) فيبوناتشي  —  Fibonacci (آلي من آخر سوينج)
// ============================================================================
GRP_FB = "🌀 5) فيبوناتشي"
showFib = input.bool(true, "تفعيل فيبوناتشي الآلي", group=GRP_FB)
fibLook = input.int(60, "نطاق البحث عن السوينج", minval=10, group=GRP_FB)

var float swHigh = na
var float swLow  = na

hh = ta.highest(high, fibLook)
ll = ta.lowest(low,  fibLook)
if barstate.islast
    swHigh := hh
    swLow  := ll

var array<line>  fibLines  = array.new<line>()
var array<label> fibLabels = array.new<label>()

f_clearFib() =>
    while array.size(fibLines) > 0
        line.delete(array.shift(fibLines))
    while array.size(fibLabels) > 0
        label.delete(array.shift(fibLabels))

if showFib and barstate.islast and not na(swHigh) and not na(swLow)
    f_clearFib()
    rng = swHigh - swLow
    levels = array.from(0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0)
    cols   = array.from(color.new(#ef5350,30), color.new(#ffa726,40), color.new(#ffee58,40), color.new(#66bb6a,40), color.new(#26c6da,40), color.new(#42a5f5,40), color.new(#26a69a,30))
    for i = 0 to array.size(levels)-1
        lv  = array.get(levels, i)
        prc = swHigh - rng * lv
        ln  = line.new(bar_index - fibLook, prc, bar_index + 10, prc, color=array.get(cols, i), style=line.style_dotted, width=1)
        lb  = label.new(bar_index + 10, prc, str.tostring(lv*100, "#.0") + "%  " + str.tostring(prc, format.mintick), style=label.style_label_left, color=color.new(color.black,100), textcolor=array.get(cols,i), size=size.small)
        array.push(fibLines, ln)
        array.push(fibLabels, lb)

// ============================================================================
//  6) إيشيموكو  —  Ichimoku Cloud
// ============================================================================
GRP_IC = "☁️ 6) إيشيموكو"
showIchi = input.bool(false, "تفعيل سحابة إيشيموكو", group=GRP_IC)
icoConv  = input.int(9,  "Tenkan",  group=GRP_IC)
icoBase  = input.int(26, "Kijun",   group=GRP_IC)
icoLag   = input.int(52, "Senkou B", group=GRP_IC)

f_donchian(len) => math.avg(ta.lowest(len), ta.highest(len))
tenkan  = f_donchian(icoConv)
kijun   = f_donchian(icoBase)
spanA   = math.avg(tenkan, kijun)
spanB   = f_donchian(icoLag)

plot(showIchi ? tenkan : na, "Tenkan", color=color.new(#2962ff,0))
plot(showIchi ? kijun  : na, "Kijun",  color=color.new(#b71c1c,0))
sa = plot(showIchi ? spanA : na, "Senkou A", color=color.new(#26a69a,50), offset=icoBase)
sb = plot(showIchi ? spanB : na, "Senkou B", color=color.new(#ef5350,50), offset=icoBase)
fill(sa, sb, color=spanA > spanB ? color.new(#26a69a, 85) : color.new(#ef5350, 85))

ichiScore = close > spanA and close > spanB ? 1 : close < spanA and close < spanB ? -1 : 0

// ============================================================================
//  7) الحجم  —  Volume (انفجار الحجم + OBV)
// ============================================================================
GRP_VL = "📊 7) الحجم"
showVol  = input.bool(true, "تفعيل تحليل الحجم", group=GRP_VL)
volMult  = input.float(2.0, "عتبة انفجار الحجم", step=0.1, group=GRP_VL)

volAvg   = ta.sma(volume, 20)
volSpike = volume > volAvg * volMult
obv      = ta.cum(math.sign(close - close[1]) * volume)
obvRising = obv > ta.sma(obv, 20)
volScoreV = (volSpike and close > open ? 1 : 0) + (obvRising ? 1 : -1)
volNorm   = volScoreV > 0 ? 1 : volScoreV < 0 ? -1 : 0

plotshape(showVol and gMinor and volSpike and close > open ? low : na, "حجم شراء", shape.circle, location.belowbar, color.new(#26a69a,0), size=size.tiny)
plotshape(showVol and gMinor and volSpike and close < open ? high : na, "حجم بيع", shape.circle, location.abovebar, color.new(#ef5350,0), size=size.tiny)

// ============================================================================
//  8) نماذج الشموع  —  Candlestick Patterns
// ============================================================================
GRP_CN = "🕯️ 8) نماذج الشموع"
showCandle = input.bool(true, "تفعيل نماذج الشموع", group=GRP_CN)

body   = math.abs(close - open)
rngTot = high - low
upWick = high - math.max(close, open)
dnWick = math.min(close, open) - low

bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
hammer     = rngTot > 0 and dnWick > body * 2 and upWick < body and close > open
shootStar  = rngTot > 0 and upWick > body * 2 and dnWick < body and close < open
doji       = rngTot > 0 and body <= rngTot * 0.1

candleScore = (bullEngulf or hammer ? 1 : 0) + (bearEngulf or shootStar ? -1 : 0)

if showCandle and gMinor
    if bullEngulf
        label.new(bar_index, low, "ابتلاع\nشرائي", yloc=yloc.belowbar, style=label.style_label_up, color=color.new(#26a69a,20), textcolor=color.white, size=size.tiny)
    if bearEngulf
        label.new(bar_index, high, "ابتلاع\nبيعي", yloc=yloc.abovebar, style=label.style_label_down, color=color.new(#ef5350,20), textcolor=color.white, size=size.tiny)
    if hammer
        label.new(bar_index, low, "مطرقة", yloc=yloc.belowbar, style=label.style_label_up, color=color.new(#66bb6a,20), textcolor=color.white, size=size.tiny)
    if shootStar
        label.new(bar_index, high, "شهاب", yloc=yloc.abovebar, style=label.style_label_down, color=color.new(#ef5350,20), textcolor=color.white, size=size.tiny)
    if doji
        label.new(bar_index, high, "دوجي", yloc=yloc.abovebar, style=label.style_label_down, color=color.new(#787b86,20), textcolor=color.white, size=size.tiny)

// ============================================================================
//  9) أموال المؤسسات  —  Smart Money / هيكل السوق (BOS)
// ============================================================================
GRP_SM = "💰 9) هيكل السوق SMC"
showSMC = input.bool(true, "تفعيل هيكل السوق", group=GRP_SM)
smcLen  = input.int(10, "حساسية الهيكل", minval=2, group=GRP_SM)

smcPH = ta.pivothigh(high, smcLen, smcLen)
smcPL = ta.pivotlow(low,  smcLen, smcLen)
var float lastPH = na
var float lastPL = na
if not na(smcPH)
    lastPH := smcPH
if not na(smcPL)
    lastPL := smcPL

crossPH = ta.crossover(close, lastPH)
crossPL = ta.crossunder(close, lastPL)
bosUp   = not na(lastPH) and crossPH
bosDn   = not na(lastPL) and crossPL
var int smcBias = 0
if bosUp
    smcBias := 1
if bosDn
    smcBias := -1

if showSMC and gMajor and bosUp
    label.new(bar_index, high, "BOS▲", yloc=yloc.abovebar, style=label.style_label_down, color=color.new(#26a69a,10), textcolor=color.white, size=size.small)
if showSMC and gMajor and bosDn
    label.new(bar_index, low, "BOS▼", yloc=yloc.belowbar, style=label.style_label_up, color=color.new(#ef5350,10), textcolor=color.white, size=size.small)

// ============================================================================
//  🔗 بنية السوينج المشتركة (Zigzag)  —  أساس الموجات/الهارمونك/النماذج/التنبؤ
// ============================================================================
GRP_ST = "🔗 بنية السوينج (مشترك)"
zzLen   = input.int(8, "حساسية نقاط السوينج", minval=2, group=GRP_ST)
showZig = input.bool(true, "رسم خطوط الزجزاج", group=GRP_ST)

var array<float> swP = array.new<float>()   // أسعار نقاط السوينج بالتسلسل
var array<int>   swX = array.new<int>()      // مؤشر الشمعة لكل نقطة
var array<bool>  swH = array.new<bool>()     // true=قمة ، false=قاع

f_addSw(float p, int x, bool isH) =>
    n = array.size(swP)
    if n > 0 and array.get(swH, n-1) == isH
        lp = array.get(swP, n-1)
        if (isH and p > lp) or (not isH and p < lp)
            array.set(swP, n-1, p)
            array.set(swX, n-1, x)
    else
        array.push(swP, p)
        array.push(swX, x)
        array.push(swH, isH)
    if array.size(swP) > 15
        array.shift(swP)
        array.shift(swX)
        array.shift(swH)

phZ = ta.pivothigh(high, zzLen, zzLen)
plZ = ta.pivotlow(low,  zzLen, zzLen)
if not na(phZ)
    f_addSw(phZ, bar_index - zzLen, true)
if not na(plZ)
    f_addSw(plZ, bar_index - zzLen, false)

f_near(float v, float t, float tol) => v >= t * (1 - tol) and v <= t * (1 + tol)

// رسم خطوط الزجزاج التي تصل نقاط السوينج
var array<line> zzLines = array.new<line>()
if showZig and gStruct and barstate.islast
    while array.size(zzLines) > 0
        line.delete(array.shift(zzLines))
    if array.size(swP) >= 2
        for i = 1 to array.size(swP) - 1
            ln = line.new(array.get(swX, i-1), array.get(swP, i-1), array.get(swX, i), array.get(swP, i), color=color.new(#787b86, 30), width=1)
            array.push(zzLines, ln)

// ============================================================================
//  11) كشف الدايفرجنس  —  Divergence (RSI ضد السعر)
// ============================================================================
GRP_DV = "🔀 11) الدايفرجنس"
showDiv = input.bool(true, "تفعيل كشف الدايفرجنس", group=GRP_DV)
divLB   = input.int(5, "حساسية البيفوت للدايفرجنس", minval=2, group=GRP_DV)

oscD = rsi
phD  = ta.pivothigh(high, divLB, divLB)
plD  = ta.pivotlow(low,  divLB, divLB)

var float prevPLp = na
var float prevPLo = na
var float prevPHp = na
var float prevPHo = na
bullDiv = false
bearDiv = false
hidBull = false
hidBear = false

if not na(plD)
    curP = low[divLB]
    curO = oscD[divLB]
    if not na(prevPLp)
        if curP < prevPLp and curO > prevPLo
            bullDiv := true                    // دايفرجنس إيجابي عادي
        if curP > prevPLp and curO < prevPLo
            hidBull := true                    // دايفرجنس إيجابي مخفي
    prevPLp := curP
    prevPLo := curO

if not na(phD)
    curP = high[divLB]
    curO = oscD[divLB]
    if not na(prevPHp)
        if curP > prevPHp and curO < prevPHo
            bearDiv := true                    // دايفرجنس سلبي عادي
        if curP < prevPHp and curO > prevPHo
            hidBear := true                    // دايفرجنس سلبي مخفي
    prevPHp := curP
    prevPHo := curO

if showDiv and gMajor and bullDiv
    label.new(bar_index - divLB, low[divLB], "📈 دايفرجنس\nإيجابي", yloc=yloc.belowbar, style=label.style_label_up, color=color.new(#26a69a, 15), textcolor=color.white, size=size.tiny)
if showDiv and gMajor and bearDiv
    label.new(bar_index - divLB, high[divLB], "📉 دايفرجنس\nسلبي", yloc=yloc.abovebar, style=label.style_label_down, color=color.new(#ef5350, 15), textcolor=color.white, size=size.tiny)
if showDiv and gMajor and _full and hidBull
    label.new(bar_index - divLB, low[divLB], "▲ مخفي", yloc=yloc.belowbar, style=label.style_label_up, color=color.new(#66bb6a, 35), textcolor=color.white, size=size.tiny)
if showDiv and gMajor and _full and hidBear
    label.new(bar_index - divLB, high[divLB], "▼ مخفي", yloc=yloc.abovebar, style=label.style_label_down, color=color.new(#ef9a9a, 35), textcolor=color.white, size=size.tiny)

var int divBias = 0
if bullDiv or hidBull
    divBias := 1
if bearDiv or hidBear
    divBias := -1

// ============================================================================
//  12) مناطق العرض والطلب  —  Supply / Demand Zones
// ============================================================================
GRP_SD = "🟩 12) العرض والطلب"
showSD = input.bool(true, "تفعيل مناطق العرض/الطلب", group=GRP_SD)
sdLen  = input.int(10, "حساسية المنطقة", minval=2, group=GRP_SD)
sdMax  = input.int(3,  "عدد المناطق لكل نوع", minval=1, maxval=8, group=GRP_SD)

var array<box> demBoxes = array.new<box>()
var array<box> supBoxes = array.new<box>()
var float demTop = na
var float demBot = na
var float supTop = na
var float supBot = na

sdPH = ta.pivothigh(high, sdLen, sdLen)
sdPL = ta.pivotlow(low,  sdLen, sdLen)

if showSD and not na(sdPL)
    bTop = math.max(open[sdLen], close[sdLen])
    bBot = low[sdLen]
    bx = box.new(bar_index - sdLen, bTop, bar_index, bBot, border_color=color.new(#26a69a, 40), bgcolor=color.new(#26a69a, 88), text="طلب", text_color=color.new(#26a69a, 0), text_size=size.tiny, text_halign=text.align_left)
    array.push(demBoxes, bx)
    demTop := bTop
    demBot := bBot
    if array.size(demBoxes) > sdMax
        box.delete(array.shift(demBoxes))

if showSD and not na(sdPH)
    bTop = high[sdLen]
    bBot = math.min(open[sdLen], close[sdLen])
    bx = box.new(bar_index - sdLen, bTop, bar_index, bBot, border_color=color.new(#ef5350, 40), bgcolor=color.new(#ef5350, 88), text="عرض", text_color=color.new(#ef5350, 0), text_size=size.tiny, text_halign=text.align_left)
    array.push(supBoxes, bx)
    supTop := bTop
    supBot := bBot
    if array.size(supBoxes) > sdMax
        box.delete(array.shift(supBoxes))

// تمديد المناطق إلى اليمين لتبقى ظاهرة (مع الحماية من المصفوفة الفارغة)
if showSD and barstate.islast
    if array.size(demBoxes) > 0
        for i = 0 to array.size(demBoxes) - 1
            box.set_right(array.get(demBoxes, i), bar_index + 8)
    if array.size(supBoxes) > 0
        for i = 0 to array.size(supBoxes) - 1
            box.set_right(array.get(supBoxes, i), bar_index + 8)

sdScore = (not na(demTop) and close >= demBot and close <= demTop * 1.005) ? 1 : (not na(supBot) and close <= supTop and close >= supBot * 0.995) ? -1 : 0

// ============================================================================
//  13) التحليل الموجي  —  Elliott Waves (تقريبي)
// ============================================================================
GRP_WV = "🌊 13) التحليل الموجي"
showWave = input.bool(true, "تفعيل ترقيم الموجات", group=GRP_WV)

var array<label> wvLab = array.new<label>()
var string infoWave = "—"
if showWave and gStruct and barstate.islast
    while array.size(wvLab) > 0
        label.delete(array.shift(wvLab))
    n = array.size(swP)
    if n >= 2
        cnt = math.min(n, 8)
        names = array.from("1", "2", "3", "4", "5", "A", "B", "C")
        startI = n - cnt
        for i = 0 to cnt - 1
            isH = array.get(swH, startI + i)
            nm  = array.get(names, i)
            lb = label.new(array.get(swX, startI + i), array.get(swP, startI + i), nm, style=isH ? label.style_label_down : label.style_label_up, color=color.new(#2962ff, 20), textcolor=color.white, size=size.small)
            array.push(wvLab, lb)
        infoWave := "موجة " + array.get(names, cnt - 1)

// ============================================================================
//  14) النماذج التوافقية  —  Harmonic Patterns (XABCD)
// ============================================================================
GRP_HM = "🦋 14) الهارمونك"
showHarm = input.bool(true, "تفعيل النماذج التوافقية", group=GRP_HM)
harmTol  = input.float(0.1, "سماحية النِسَب", step=0.01, group=GRP_HM)

var array<line>  harmLines = array.new<line>()
var array<label> harmLab   = array.new<label>()
var string infoHarmonic = "—"
var int    harmBias = 0

if showHarm and gStruct and barstate.islast
    while array.size(harmLines) > 0
        line.delete(array.shift(harmLines))
    while array.size(harmLab) > 0
        label.delete(array.shift(harmLab))
    infoHarmonic := "—"
    harmBias := 0
    n = array.size(swP)
    if n >= 5
        Xp = array.get(swP, n-5)
        Ap = array.get(swP, n-4)
        Bp = array.get(swP, n-3)
        Cp = array.get(swP, n-2)
        Dp = array.get(swP, n-1)
        Xx = array.get(swX, n-5)
        Ax = array.get(swX, n-4)
        Bx = array.get(swX, n-3)
        Cx = array.get(swX, n-2)
        Dx = array.get(swX, n-1)
        XA = math.abs(Ap - Xp)
        AB = math.abs(Bp - Ap)
        BC = math.abs(Cp - Bp)
        CD = math.abs(Dp - Cp)
        AD = math.abs(Dp - Ap)
        rAB = XA > 0 ? AB / XA : 0.0
        rBC = AB > 0 ? BC / AB : 0.0
        rCD = BC > 0 ? CD / BC : 0.0
        rAD = XA > 0 ? AD / XA : 0.0
        bullPat = not array.get(swH, n-1)        // D قاع ⇐ نموذج شرائي
        pname = ""
        if f_near(rAB, 0.618, harmTol) and rBC >= 0.382 - harmTol and rBC <= 0.886 + harmTol and f_near(rAD, 0.786, harmTol)
            pname := "Gartley جارتلي"
        else if rAB >= 0.382 - harmTol and rAB <= 0.5 + harmTol and f_near(rAD, 0.886, harmTol) and rCD >= 1.618 - 0.3
            pname := "Bat الخفاش"
        else if f_near(rAB, 0.786, harmTol) and rAD >= 1.272 - harmTol and rAD <= 1.618 + harmTol
            pname := "Butterfly الفراشة"
        else if rAB >= 0.382 - harmTol and rAB <= 0.618 + harmTol and f_near(rAD, 1.618, harmTol)
            pname := "Crab السلطعون"
        if pname != ""
            col = bullPat ? color.new(#26a69a, 0) : color.new(#ef5350, 0)
            array.push(harmLines, line.new(Xx, Xp, Ax, Ap, color=col, width=2))
            array.push(harmLines, line.new(Ax, Ap, Bx, Bp, color=col, width=2))
            array.push(harmLines, line.new(Bx, Bp, Cx, Cp, color=col, width=2))
            array.push(harmLines, line.new(Cx, Cp, Dx, Dp, color=col, width=2))
            array.push(harmLines, line.new(Xx, Xp, Dx, Dp, color=color.new(col, 70), style=line.style_dashed, width=1))
            array.push(harmLab, label.new(Dx, Dp, (bullPat ? "▲ " : "▼ ") + pname, style=bullPat ? label.style_label_up : label.style_label_down, color=col, textcolor=color.white, size=size.small))
            infoHarmonic := (bullPat ? "شرائي: " : "بيعي: ") + pname
            harmBias := bullPat ? 1 : -1

// ============================================================================
//  15) التحركات التنبؤية  —  Predictive Projection (أهداف فيبو)
// ============================================================================
GRP_PR = "🔮 15) التحركات التنبؤية"
showPred = input.bool(true, "تفعيل الأهداف التنبؤية", group=GRP_PR)
predOff  = input.int(20, "امتداد الإسقاط (شموع)", minval=5, group=GRP_PR)

var array<line>  predLines = array.new<line>()
var array<label> predLab   = array.new<label>()
var int predBias = 0

if showPred and gStruct and barstate.islast
    while array.size(predLines) > 0
        line.delete(array.shift(predLines))
    while array.size(predLab) > 0
        label.delete(array.shift(predLab))
    n = array.size(swP)
    if n >= 2
        lastP = array.get(swP, n-1)
        prevP = array.get(swP, n-2)
        lastIsH = array.get(swH, n-1)
        leg = math.abs(lastP - prevP)
        dir = lastIsH ? -1 : 1                 // آخر نقطة قمة ⇒ هبوط متوقع، قاع ⇒ صعود
        predBias := dir
        ratios = array.from(0.618, 1.0, 1.618)
        rcols  = array.from(color.new(#ffa726, 0), color.new(#42a5f5, 0), color.new(#ab47bc, 0))
        for i = 0 to array.size(ratios) - 1
            tgt = lastP + dir * leg * array.get(ratios, i)
            ln = line.new(bar_index, lastP, bar_index + predOff, tgt, color=array.get(rcols, i), style=line.style_dashed, width=1)
            array.push(predLines, ln)
            lb = label.new(bar_index + predOff, tgt, "🎯 " + str.tostring(array.get(ratios, i)) + " → " + str.tostring(tgt, format.mintick), style=label.style_label_left, color=color.new(color.black, 100), textcolor=array.get(rcols, i), size=size.tiny)
            array.push(predLab, lb)
        // سهم اتجاه التوقع
        array.push(predLab, label.new(bar_index + predOff, lastP + dir * leg * 0.5, dir > 0 ? "↗ صعود متوقع" : "↘ هبوط متوقع", style=label.style_none, textcolor=dir > 0 ? cUp : cDn, size=size.small))

// ============================================================================
//  16) بداية التصحيح ونهايته  —  Correction Start / End
// ============================================================================
GRP_CR = "✂️ 16) التصحيح"
showCorr = input.bool(true, "تفعيل رصد التصحيح", group=GRP_CR)

var float corrHigh = na
var float corrLow = na
var bool  inCorrUp = false      // تصحيح هابط داخل اتجاه صاعد
var bool  inCorrDn = false      // تصحيح صاعد داخل اتجاه هابط
var string infoCorr = "—"
var array<box> corrZone = array.new<box>()

f_clearCorr() =>
    while array.size(corrZone) > 0
        box.delete(array.shift(corrZone))

// بدء تصحيح هابط: قمة جديدة أثناء اتجاه صاعد
if showCorr and not na(phZ) and trendUp
    corrHigh := phZ
    n = array.size(swP)
    corrLow  := n >= 2 ? array.get(swP, n-2) : ema2
    inCorrUp := true
    inCorrDn := false
    infoCorr := "بدأ تصحيح هابط ⤵"
    if gMajor
        label.new(bar_index - zzLen, phZ, "بداية تصحيح ⤵", yloc=yloc.abovebar, style=label.style_label_down, color=color.new(#ffa726, 10), textcolor=color.white, size=size.tiny)

// بدء تصحيح صاعد: قاع جديد أثناء اتجاه هابط
if showCorr and not na(plZ) and trendDn
    corrLow  := plZ
    n = array.size(swP)
    corrHigh := n >= 2 ? array.get(swP, n-2) : ema2
    inCorrDn := true
    inCorrUp := false
    infoCorr := "بدأ تصحيح صاعد ⤴"
    if gMajor
        label.new(bar_index - zzLen, plZ, "بداية تصحيح ⤴", yloc=yloc.belowbar, style=label.style_label_up, color=color.new(#ffa726, 10), textcolor=color.white, size=size.tiny)

// منطقة نهاية التصحيح المتوقعة (فيبو 0.5–0.618 من الموجة)
if showCorr and barstate.islast and not na(corrHigh) and not na(corrLow) and (inCorrUp or inCorrDn)
    f_clearCorr()
    rng = corrHigh - corrLow
    z1 = corrHigh - rng * 0.5
    z2 = corrHigh - rng * 0.618
    bx = box.new(bar_index - 5, math.max(z1, z2), bar_index + 8, math.min(z1, z2), border_color=color.new(#ffee58, 30), bgcolor=color.new(#ffee58, 85), text="منطقة نهاية التصحيح", text_color=color.new(#fdd835, 0), text_size=size.tiny)
    array.push(corrZone, bx)

// نهاية التصحيح: استئناف الاتجاه الأصلي
crossCorrHi = ta.crossover(close, corrHigh)
crossCorrLo = ta.crossunder(close, corrLow)
corrEndUp = inCorrUp and not na(corrHigh) and crossCorrHi
corrEndDn = inCorrDn and not na(corrLow)  and crossCorrLo
if corrEndUp
    inCorrUp := false
    infoCorr := "انتهى التصحيح ✅ استئناف صعود"
    label.new(bar_index, low, "نهاية التصحيح ✅", yloc=yloc.belowbar, style=label.style_label_up, color=color.new(#26a69a, 10), textcolor=color.white, size=size.small)
if corrEndDn
    inCorrDn := false
    infoCorr := "انتهى التصحيح ✅ استئناف هبوط"
    label.new(bar_index, high, "نهاية التصحيح ✅", yloc=yloc.abovebar, style=label.style_label_down, color=color.new(#ef5350, 10), textcolor=color.white, size=size.small)

// ============================================================================
//  17) النماذج الفنية الكلاسيكية  —  Chart Patterns
// ============================================================================
GRP_CP = "📐 17) النماذج الفنية"
showCP  = input.bool(true, "تفعيل النماذج الفنية", group=GRP_CP)
cpTol   = input.float(0.03, "سماحية تساوي القمم/القيعان", step=0.005, group=GRP_CP)

var array<line>  cpLines = array.new<line>()
var array<label> cpLab   = array.new<label>()
var string infoPattern = "—"
var int    cpBias = 0

if showCP and gStruct and barstate.islast
    while array.size(cpLines) > 0
        line.delete(array.shift(cpLines))
    while array.size(cpLab) > 0
        label.delete(array.shift(cpLab))
    n = array.size(swP)
    infoPattern := "—"
    cpBias := 0
    // قمة/قاع مزدوج: آخر 3 نقاط (أسماء dt* لتفادي التعارض مع متغيرات الرسم العامة)
    if n >= 3
        dtP1 = array.get(swP, n-3)
        dtP2 = array.get(swP, n-1)
        dtX1 = array.get(swX, n-3)
        dtX2 = array.get(swX, n-1)
        dtH1 = array.get(swH, n-3)
        dtH2 = array.get(swH, n-1)
        if dtH1 and dtH2 and f_near(dtP2, dtP1, cpTol)
            array.push(cpLines, line.new(dtX1, math.max(dtP1, dtP2), dtX2, math.max(dtP1, dtP2), color=color.new(#ef5350, 0), width=2, style=line.style_dashed))
            array.push(cpLab, label.new(dtX2, math.max(dtP1, dtP2), "قمة مزدوجة ⛰️⛰️", style=label.style_label_down, color=color.new(#ef5350, 10), textcolor=color.white, size=size.small))
            infoPattern := "قمة مزدوجة"
            cpBias := -1
        if not dtH1 and not dtH2 and f_near(dtP2, dtP1, cpTol)
            array.push(cpLines, line.new(dtX1, math.min(dtP1, dtP2), dtX2, math.min(dtP1, dtP2), color=color.new(#26a69a, 0), width=2, style=line.style_dashed))
            array.push(cpLab, label.new(dtX2, math.min(dtP1, dtP2), "قاع مزدوج ⚓⚓", style=label.style_label_up, color=color.new(#26a69a, 10), textcolor=color.white, size=size.small))
            infoPattern := "قاع مزدوج"
            cpBias := 1
    // رأس وكتفين / مقلوب: آخر 5 نقاط
    if n >= 5 and infoPattern == "—"
        a = array.get(swP, n-5)
        b = array.get(swP, n-4)
        c = array.get(swP, n-3)
        d = array.get(swP, n-2)
        e = array.get(swP, n-1)
        ax = array.get(swX, n-5)
        ex = array.get(swX, n-1)
        ha = array.get(swH, n-5)
        if ha and c > a and c > e and f_near(e, a, cpTol + 0.02)
            array.push(cpLab, label.new(ex, c, "رأس وكتفين 👤", style=label.style_label_down, color=color.new(#ef5350, 10), textcolor=color.white, size=size.small))
            array.push(cpLines, line.new(ax, math.min(b, d), ex, math.min(b, d), color=color.new(#ef5350, 0), width=2, style=line.style_dotted))
            infoPattern := "رأس وكتفين"
            cpBias := -1
        if not ha and c < a and c < e and f_near(e, a, cpTol + 0.02)
            array.push(cpLab, label.new(ex, c, "رأس وكتفين مقلوب 🙃", style=label.style_label_up, color=color.new(#26a69a, 10), textcolor=color.white, size=size.small))
            array.push(cpLines, line.new(ax, math.max(b, d), ex, math.max(b, d), color=color.new(#26a69a, 0), width=2, style=line.style_dotted))
            infoPattern := "رأس وكتفين مقلوب"
            cpBias := 1
    // مثلث متقارب: قمم هابطة وقيعان صاعدة
    if n >= 4 and infoPattern == "—"
        float hi1 = na
        float hi2 = na
        float lo1 = na
        float lo2 = na
        int j = n - 1
        int jstop = math.max(n - 6, 0)
        while j >= jstop
            if array.get(swH, j)
                if na(hi1)
                    hi1 := array.get(swP, j)
                else if na(hi2)
                    hi2 := array.get(swP, j)
            else
                if na(lo1)
                    lo1 := array.get(swP, j)
                else if na(lo2)
                    lo2 := array.get(swP, j)
            j := j - 1
        if not na(hi1) and not na(hi2) and not na(lo1) and not na(lo2) and hi1 < hi2 and lo1 > lo2
            array.push(cpLab, label.new(bar_index, high, "مثلث متقارب 📐", style=label.style_label_down, color=color.new(#787b86, 10), textcolor=color.white, size=size.small))
            infoPattern := "مثلث متقارب"

// ============================================================================
//  🅦 مدرسة وايكوف  —  Wyckoff Method (نطاق التداول + الأحداث الرئيسية)
// ============================================================================
GRP_WY   = "🅦 وايكوف"
showWyk  = input.bool(true, "تفعيل مدرسة وايكوف", group=GRP_WY)
wyLen    = input.int(30, "طول نطاق التداول", minval=10, group=GRP_WY)
wyVolMlt = input.float(1.8, "عتبة الحجم العالي", step=0.1, group=GRP_WY)

// حسابات أساسية (كلها عامة لتُنفّذ كل شمعة)
wyVolAvg = ta.sma(volume, 20)
wyAtr    = ta.atr(10)
trHigh   = ta.highest(high, wyLen)[1]     // مقاومة النطاق (بدون الشمعة الحالية)
trLow    = ta.lowest(low,  wyLen)[1]      // دعم النطاق
trHiFull = ta.highest(high, wyLen)
trLoFull = ta.lowest(low,  wyLen)
wyHiVol  = volume > wyVolAvg * wyVolMlt
wideBar  = (high - low) > wyAtr * 1.5

// الأحداث الرئيسية في منهج وايكوف
wySpring   = showWyk and low < trLow  and close > trLow  and close > open                                  // اختراق كاذب لأسفل ⇒ صعودي
wyUpthrust = showWyk and high > trHigh and close < trHigh and close < open                                 // اختراق كاذب لأعلى ⇒ هبوطي
wySC       = showWyk and wyHiVol and wideBar and close < open and (close - low) > (high - low) * 0.5 and low <= trLoFull   // ذروة بيع
wyBC       = showWyk and wyHiVol and wideBar and close > open and (high - close) > (high - low) * 0.5 and high >= trHiFull  // ذروة شراء
wySOS      = showWyk and close > trHigh and close > open and wyHiVol and wideBar                           // علامة قوة (كسر صاعد بحجم)
wySOW      = showWyk and close < trLow  and close < open and wyHiVol and wideBar                           // علامة ضعف (كسر هابط بحجم)

var int wyBias = 0
var string infoWyk = "—"
// آلة حالة مراحل وايكوف:  wyType = تجميع/تصريف ، wyPhase: 1=A 2=B 3=C 4=D 5=E
var string wyType  = ""
var int    wyPhase = 0

// المرحلة A — توقف الاتجاه السابق (ذروة الحجم)
if wySC
    wyType  := "تجميع"
    wyPhase := 1
    wyBias  := 1
    infoWyk := "ذروة بيع SC"
if wyBC
    wyType  := "تصريف"
    wyPhase := 1
    wyBias  := -1
    infoWyk := "ذروة شراء BC"
// المرحلة B — البناء (بعد A وقبل أحداث الاختبار)
if wyPhase == 1 and not wySC and not wyBC
    wyPhase := 2
    infoWyk := "بناء السبب (B)"
// المرحلة C — الاختبار النهائي (Spring/Upthrust)
if wySpring
    wyType  := "تجميع"
    wyPhase := 3
    wyBias  := 1
    infoWyk := "Spring (ربيع) ⇧"
if wyUpthrust
    wyType  := "تصريف"
    wyPhase := 3
    wyBias  := -1
    infoWyk := "Upthrust ⇩"
// المرحلة D — علامات القوة/الضعف داخل النطاق
if wySOS
    wyType  := "تجميع"
    wyPhase := 4
    wyBias  := 1
    infoWyk := "علامة قوة SOS"
if wySOW
    wyType  := "تصريف"
    wyPhase := 4
    wyBias  := -1
    infoWyk := "علامة ضعف SOW"
// المرحلة E — مغادرة النطاق وبدء الاتجاه
if wyPhase >= 3 and wyType == "تجميع" and close > trHigh
    wyPhase := 5
    wyBias  := 1
    infoWyk := "بداية ترند صاعد (E)"
if wyPhase >= 3 and wyType == "تصريف" and close < trLow
    wyPhase := 5
    wyBias  := -1
    infoWyk := "بداية ترند هابط (E)"

// نص المرحلة الحالية (تجميع/تصريف • الحرف)
phLetter = wyPhase == 1 ? "A" : wyPhase == 2 ? "B" : wyPhase == 3 ? "C" : wyPhase == 4 ? "D" : wyPhase == 5 ? "E" : "—"
wyPhaseTxt = wyPhase == 0 ? "—" : wyType + " • " + phLetter

// رسم الأحداث على الشارت (محكومة ببوابة التنظيف)
if wySpring and gMajor
    label.new(bar_index, low, "Spring 🌱", yloc=yloc.belowbar, style=label.style_label_up, color=color.new(#26a69a, 10), textcolor=color.white, size=size.small)
if wyUpthrust and gMajor
    label.new(bar_index, high, "Upthrust ⚡", yloc=yloc.abovebar, style=label.style_label_down, color=color.new(#ef5350, 10), textcolor=color.white, size=size.small)
if wySC and gMajor and _full
    label.new(bar_index, low, "SC ذروة بيع", yloc=yloc.belowbar, style=label.style_label_up, color=color.new(#66bb6a, 15), textcolor=color.white, size=size.tiny)
if wyBC and gMajor and _full
    label.new(bar_index, high, "BC ذروة شراء", yloc=yloc.abovebar, style=label.style_label_down, color=color.new(#ef9a9a, 15), textcolor=color.white, size=size.tiny)
if wySOS and gMajor and _full
    label.new(bar_index, low, "SOS قوة", yloc=yloc.belowbar, style=label.style_label_up, color=color.new(#2e7d32, 10), textcolor=color.white, size=size.tiny)
if wySOW and gMajor and _full
    label.new(bar_index, high, "SOW ضعف", yloc=yloc.abovebar, style=label.style_label_down, color=color.new(#c62828, 10), textcolor=color.white, size=size.tiny)

// رسم نطاق التداول (Trading Range) على آخر شمعة
var box  wyBox  = na
var line wyHiLn = na
var line wyLoLn = na
if showWyk and barstate.islast and not na(trHigh) and not na(trLow)
    box.delete(wyBox)
    line.delete(wyHiLn)
    line.delete(wyLoLn)
    wyBoxTxt = wyPhase == 0 ? "نطاق تداول وايكوف" : "وايكوف — " + wyPhaseTxt
    wyBox  := box.new(bar_index - wyLen, trHigh, bar_index + 8, trLow, border_color=color.new(#5c6bc0, 30), bgcolor=color.new(#5c6bc0, 93), text=wyBoxTxt, text_color=color.new(#5c6bc0, 0), text_size=size.tiny, text_halign=text.align_center, text_valign=text.align_top)
    wyHiLn := line.new(bar_index - wyLen, trHigh, bar_index + 8, trHigh, color=color.new(#ef5350, 20), style=line.style_dashed, width=1)
    wyLoLn := line.new(bar_index - wyLen, trLow,  bar_index + 8, trLow,  color=color.new(#26a69a, 20), style=line.style_dashed, width=1)

// ============================================================================
//  18) النتيجة المجمّعة + لوحة المعلومات
// ============================================================================
// تجميع نقاط كل مدرسة (مرجّحة)
wTrend  = showTrend ? trendScore : 0
wMom    = showMom   ? momNorm    : 0
wVol    = showBB    ? volScore   : 0
wIchi   = showIchi  ? ichiScore  : 0
wVolm   = showVol   ? volNorm    : 0
wCandle = showCandle? (candleScore > 0 ? 1 : candleScore < 0 ? -1 : 0) : 0
wSMC    = showSMC   ? smcBias    : 0
wDiv    = showDiv   ? divBias    : 0
wSD     = showSD    ? sdScore    : 0
wHarm   = showHarm  ? harmBias   : 0
wPred   = showPred  ? predBias   : 0
wCP     = showCP    ? cpBias     : 0
wWyk    = showWyk   ? wyBias     : 0

totalScore = wTrend*2 + wMom*1.5 + wVol + wIchi + wVolm + wCandle + wSMC*1.5 + wDiv*1.5 + wSD + wHarm + wPred*0.5 + wCP + wWyk*1.5
maxScore   = 2 + 1.5 + 1 + (showIchi?1:0) + 1 + 1 + 1.5 + 1.5 + 1 + 1 + 0.5 + 1 + 1.5
scorePct   = maxScore != 0 ? totalScore / maxScore * 100 : 0

verdict = scorePct >=  50 ? "شراء قوي 🟢" :
          scorePct >=  20 ? "شراء 🟢" :
          scorePct <= -50 ? "بيع قوي 🔴" :
          scorePct <= -20 ? "بيع 🔴" : "حياد ⚪"
verdictCol = scorePct >= 20 ? cUp : scorePct <= -20 ? cDn : cNeu

f_sigTxt(s) => s > 0 ? "صاعد ▲" : s < 0 ? "هابط ▼" : "حياد ●"
f_sigCol(s) => s > 0 ? cUp     : s < 0 ? cDn     : cNeu

dashPosition = dashPos == "أعلى اليمين"  ? position.top_right :
               dashPos == "أعلى اليسار"  ? position.top_left  :
               dashPos == "أسفل اليمين"  ? position.bottom_right : position.bottom_left

if showDash and barstate.islast
    var table t = table.new(dashPosition, 2, 20, bgcolor=cBgDash, border_color=color.new(#434651,40), border_width=1, frame_color=color.new(#434651,0), frame_width=1)
    table.cell(t, 0, 0, "🏛️ محلل المدارس", text_color=cTxt, text_size=size.normal, bgcolor=color.new(#2962ff,30))
    table.cell(t, 1, 0, verdict, text_color=color.white, text_size=size.normal, bgcolor=verdictCol)

    table.cell(t, 0, 1, "الاتجاه",       text_color=cTxt, text_size=size.small)
    table.cell(t, 1, 1, f_sigTxt(wTrend), text_color=f_sigCol(wTrend), text_size=size.small)
    table.cell(t, 0, 2, "الزخم",         text_color=cTxt, text_size=size.small)
    table.cell(t, 1, 2, f_sigTxt(wMom),   text_color=f_sigCol(wMom),  text_size=size.small)
    table.cell(t, 0, 3, "التقلب/بولينجر", text_color=cTxt, text_size=size.small)
    table.cell(t, 1, 3, f_sigTxt(wVol),   text_color=f_sigCol(wVol),  text_size=size.small)
    table.cell(t, 0, 4, "إيشيموكو",      text_color=cTxt, text_size=size.small)
    table.cell(t, 1, 4, showIchi ? f_sigTxt(wIchi) : "معطّل", text_color=showIchi?f_sigCol(wIchi):cNeu, text_size=size.small)
    table.cell(t, 0, 5, "الحجم",         text_color=cTxt, text_size=size.small)
    table.cell(t, 1, 5, f_sigTxt(wVolm),  text_color=f_sigCol(wVolm), text_size=size.small)
    table.cell(t, 0, 6, "الشموع",        text_color=cTxt, text_size=size.small)
    table.cell(t, 1, 6, f_sigTxt(wCandle),text_color=f_sigCol(wCandle),text_size=size.small)
    table.cell(t, 0, 7, "هيكل السوق",    text_color=cTxt, text_size=size.small)
    table.cell(t, 1, 7, f_sigTxt(wSMC),   text_color=f_sigCol(wSMC),  text_size=size.small)
    table.cell(t, 0, 8, "الدايفرجنس",    text_color=cTxt, text_size=size.small)
    table.cell(t, 1, 8, f_sigTxt(wDiv),   text_color=f_sigCol(wDiv),  text_size=size.small)
    table.cell(t, 0, 9, "العرض/الطلب",   text_color=cTxt, text_size=size.small)
    table.cell(t, 1, 9, f_sigTxt(wSD),    text_color=f_sigCol(wSD),   text_size=size.small)
    table.cell(t, 0, 10, "الموجة",        text_color=cTxt, text_size=size.small)
    table.cell(t, 1, 10, infoWave,        text_color=color.new(#2962ff,0), text_size=size.small)
    table.cell(t, 0, 11, "الهارمونك",     text_color=cTxt, text_size=size.small)
    table.cell(t, 1, 11, infoHarmonic,    text_color=f_sigCol(wHarm), text_size=size.small)
    table.cell(t, 0, 12, "النموذج الفني", text_color=cTxt, text_size=size.small)
    table.cell(t, 1, 12, infoPattern,     text_color=f_sigCol(wCP),   text_size=size.small)
    table.cell(t, 0, 13, "التصحيح",       text_color=cTxt, text_size=size.small)
    table.cell(t, 1, 13, infoCorr,        text_color=color.new(#fdd835,0), text_size=size.small)
    table.cell(t, 0, 14, "التوقع",        text_color=cTxt, text_size=size.small)
    table.cell(t, 1, 14, predBias>0?"صعود متوقع ↗":predBias<0?"هبوط متوقع ↘":"—", text_color=f_sigCol(wPred), text_size=size.small)
    table.cell(t, 0, 15, "وايكوف",        text_color=cTxt, text_size=size.small)
    table.cell(t, 1, 15, infoWyk,         text_color=f_sigCol(wWyk), text_size=size.small)
    table.cell(t, 0, 16, "مرحلة وايكوف",   text_color=cTxt, text_size=size.small)
    table.cell(t, 1, 16, wyPhaseTxt,       text_color=f_sigCol(wWyk), text_size=size.small)

    table.cell(t, 0, 17, "RSI",  text_color=cTxt, text_size=size.small)
    table.cell(t, 1, 17, str.tostring(rsi, "#.0"), text_color=rsi>rsiOB?cDn:rsi<rsiOS?cUp:cTxt, text_size=size.small)
    table.cell(t, 0, 18, "النتيجة", text_color=cTxt, text_size=size.small, bgcolor=color.new(#434651,60))
    table.cell(t, 1, 18, str.tostring(scorePct, "#") + "%", text_color=color.white, text_size=size.small, bgcolor=verdictCol)
    table.cell(t, 0, 19, "السعر", text_color=cTxt, text_size=size.small)
    table.cell(t, 1, 19, str.tostring(close, format.mintick), text_color=cTxt, text_size=size.small)

// ============================================================================
//  🎯 إشارة كول / بوت  —  CALL / PUT Signal
// ============================================================================
GRP_SIG = "🎯 إشارة كول/بوت"
showCallPut = input.bool(true,  "إظهار إشارة كول/بوت", group=GRP_SIG)
sigMode     = input.string("مبكّر", "نمط الإشارة", options=["مبكّر","مؤكّد"], group=GRP_SIG, tooltip="مبكّر = انعكاس سعري مبكّر (أقل تأخيراً) • مؤكّد = عبور النتيجة المجمّعة (أدقّ وأبطأ)")
sigStrength = input.int(35, "قوة الإشارة % (للنمط المؤكّد)", minval=15, maxval=90, group=GRP_SIG)
sigConfirm  = input.bool(true,  "فلتر الاتجاه العام (EMA200)", group=GRP_SIG)
sigCooldown = input.int(6, "فترة تهدئة بين الإشارات (شمعة)", minval=0, group=GRP_SIG)

// ── النمط المبكّر: انعكاس سعري عند دعم/مقاومة أو تشبّع + شمعة تأكيد + حجم ──
atSupport = close <= bbLower or rsi < rsiOS or (not na(demTop) and low <= demTop and close >= demBot) or wySpring
atResist  = close >= bbUpper or rsi > rsiOB or (not na(supBot) and high >= supBot and close <= supTop) or wyUpthrust
bullBar   = close > open and close > (high + low) / 2 and close > close[1]
bearBar   = close < open and close < (high + low) / 2 and close < close[1]
volOK     = volume > volAvg
earlyCall = atSupport and bullBar and rsi > rsi[1] and volOK
earlyPut  = atResist  and bearBar and rsi < rsi[1] and volOK

// ── النمط المؤكّد: عبور النتيجة المجمّعة للعتبة (يُحسب دائماً كمتغيّر عام) ──
confCall = ta.crossover(scorePct,  sigStrength)
confPut  = ta.crossunder(scorePct, -sigStrength)

rawCall = sigMode == "مبكّر" ? earlyCall : confCall
rawPut  = sigMode == "مبكّر" ? earlyPut  : confPut

// فلتر الاتجاه + تهدئة مشتركة لمنع تكرار الإشارات المتأخرة
var int lastSigBar = -1000
trendOKc = not sigConfirm or close > ema3
trendOKp = not sigConfirm or close < ema3
callSig = rawCall and trendOKc and (bar_index - lastSigBar > sigCooldown)
putSig  = rawPut  and trendOKp and (bar_index - lastSigBar > sigCooldown)
if callSig or putSig
    lastSigBar := bar_index

plotshape(showCallPut and callSig ? low  : na, "🟢 كول CALL", shape.labelup,   location.belowbar, color.new(#00c853, 0), text="كول 📈", textcolor=color.white, size=size.large)
plotshape(showCallPut and putSig  ? high : na, "🔴 بوت PUT",  shape.labeldown, location.abovebar, color.new(#d50000, 0), text="بوت 📉", textcolor=color.white, size=size.large)

// ============================================================================
//  التنبيهات  —  Alerts
// ============================================================================
buySignal  = ta.crossover(scorePct,  20)
sellSignal = ta.crossunder(scorePct, -20)
alertcondition(callSig,    "إشارة كول CALL",     "🟢 كول (CALL): توافق صعودي قوي للمدارس")
alertcondition(putSig,     "إشارة بوت PUT",      "🔴 بوت (PUT): توافق هبوطي قوي للمدارس")
alertcondition(buySignal,  "إشارة شراء مجمّعة",  "🟢 إشارة شراء: تجمّع مدارس التحليل على الصعود")
alertcondition(sellSignal, "إشارة بيع مجمّعة",   "🔴 إشارة بيع: تجمّع مدارس التحليل على الهبوط")
alertcondition(bosUp,      "كسر هيكل صاعد BOS",  "BOS▲ كسر هيكل صاعد")
alertcondition(bosDn,      "كسر هيكل هابط BOS",  "BOS▼ كسر هيكل هابط")
alertcondition(bullDiv,    "دايفرجنس إيجابي",    "📈 دايفرجنس إيجابي: تباعد صعودي بين السعر و RSI")
alertcondition(bearDiv,    "دايفرجنس سلبي",      "📉 دايفرجنس سلبي: تباعد هبوطي بين السعر و RSI")
alertcondition(corrEndUp,  "نهاية تصحيح صاعد",   "✅ انتهى التصحيح واستأنف الصعود")
alertcondition(corrEndDn,  "نهاية تصحيح هابط",   "✅ انتهى التصحيح واستأنف الهبوط")
alertcondition(wySpring,   "وايكوف Spring",      "🌱 وايكوف: Spring اختراق كاذب لأسفل (إشارة صعود)")
alertcondition(wyUpthrust, "وايكوف Upthrust",    "⚡ وايكوف: Upthrust اختراق كاذب لأعلى (إشارة هبوط)")

plotshape(buySignal  and gMajor ? low  : na, "إشارة شراء", shape.labelup,   location.belowbar, cUp, text="شراء",  textcolor=color.white, size=size.small)
plotshape(sellSignal and gMajor ? high : na, "إشارة بيع",  shape.labeldown, location.abovebar, cDn, text="بيع",   textcolor=color.white, size=size.small)
